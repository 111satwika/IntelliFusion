.env
__pycache__/
*.pyc
.venv/
venv/

# TLS private keys/certs (e.g. `tailscale cert` writes these into the
# current directory by default - never commit private key material).
*.key
*.crt

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local vector store and ingested data (regenerable via re-ingestion,
# and too large / machine-specific to commit).
data/chroma_db/
data/raw/
data/graphs/
data/media/
data/*.log
data/pending_documents.json
data/pending_documents.json.lock
