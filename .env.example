# Copy this file to .env before running `docker compose up` (Compose
# loads .env automatically - see DEPLOYMENT.md for the full walkthrough).
# .env itself is gitignored - never commit your real values.

# --- Network (docker-compose.yml only) ---
# Which host network interface the app's port 8000 is published on.
# 0.0.0.0 = reachable from your whole LAN (the default - matches
# "deploy on my own machine so other devices can reach it"). Set to
# 127.0.0.1 to restrict it to this machine only, e.g. if you're
# putting a reverse proxy in front and don't want direct access.
BIND_ADDRESS=0.0.0.0

# --- Auth (see api/auth.py) ---
# Leave APP_PASSWORD blank/unset to run with no login gate at all
# (fine for a machine only you can reach). Set it to require a login
# before the app or any of its data is reachable.
APP_PASSWORD=

# Used to sign the login cookie. If left blank, APP_PASSWORD itself is
# used as the signing key - works, but every container restart then
# invalidates existing browser sessions. Set a long random string here
# to avoid that, e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Set to 1 only if a reverse proxy in front of this terminates real
# TLS (HTTPS) - marks the login cookie Secure, so browsers will refuse
# to send it over plain HTTP. Leave 0 for plain-HTTP LAN use.
COOKIE_SECURE=0

# --- Optional ingestion/retrieval knobs (unchanged defaults if unset) ---
# Raises GitHub's anonymous 60/hour API limit to 5000/hour; required
# for ingesting GitHub Discussions specifically (GraphQL rejects
# unauthenticated requests entirely).
GITHUB_TOKEN=

# faster-whisper model size for audio/video transcription.
WHISPER_MODEL_SIZE=base

# Set to 1 to enable native CLAP audio-clip embeddings (acoustic
# similarity search) - off by default since it's a new, heavier model.
ENABLE_AUDIO_SIMILARITY_SEARCH=0
